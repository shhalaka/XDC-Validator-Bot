{
  "name": "xdc-alert",
  "version": "0.1.0",
  "private": true,
  "description": "Listen to XDCValidator smart contract events and tweet notifications.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "cli": "node dist/cli.js",
    "build": "tsc -p tsconfig.json  && xcopy assets dist\\assets /E /I /Y",
    "format": "prettier -w ."
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ethers": "^6.13.4",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "p-retry": "^6.2.1",
    "twitter-api-v2": "^1.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
